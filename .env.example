# Environment variables for Grammarwy.
# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored: never commit real secrets.
# None of these use the NEXT_PUBLIC_ prefix, so they never reach the browser.

# Optional: how the app reaches the AI.
#   claude-code   = Claude, through Claude Code and your Claude subscription
#                   (no API key; works on your own computer only)
#   gemini        = Google's Gemini, through the Gemini API with GEMINI_API_KEY
#                   (has a free tier; works anywhere, including Vercel)
#   anthropic-api = Claude, through the Anthropic API with ANTHROPIC_API_KEY
#                   (billed per use; works anywhere, including Vercel)
# Default: anthropic-api when ANTHROPIC_API_KEY is set, otherwise gemini when
# GEMINI_API_KEY is set or on Vercel, otherwise claude-code.
# AI_PROVIDER=claude-code

# Gemini API key from https://aistudio.google.com/apikey
# Only needed for gemini (for example on Vercel). Used on the server only.
# On the free tier, Google may use your texts to improve its products, and
# human reviewers may read them: don't send confidential information.
GEMINI_API_KEY=

# Optional: which Gemini model to use. Default: gemini-3.1-flash-lite
# GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: the backup Gemini model, asked when the main one fails or gives an
# unreliable answer. It has its own free allowance. Default:
# gemini-3.5-flash-lite. Set it to none to turn the backup off.
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Claude API key from https://platform.claude.com
# Only needed for anthropic-api. Used on the server only.
ANTHROPIC_API_KEY=

# Optional: where Claude Code is, if the app doesn't find it by itself.
# By default it uses the copy inside the Claude desktop app, or `claude` on PATH.
# CLAUDE_CODE_PATH=C:\path\to\claude.exe

# Optional: which Claude model to use. Default: claude-opus-5-5
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: how much Claude thinks before answering. Default: low
# Allowed: low, medium, high, xhigh, max. Higher is slower and costs more.
# ANTHROPIC_EFFORT=low

# Optional: "true" uses built-in sample answers instead of calling the AI
# (free, no AI account needed). Useful for development and testing.
USE_MOCK_AI=true

# Site password (HTTP Basic Auth): your browser's login prompt asks for these.
# Required in production (npm start and Vercel): if either is empty there,
# every request is refused. With npm run dev, leave both empty to skip the
# password. Spaces at the start or end are ignored. Use a long random password.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Optional: the Upstash Redis database that counts corrections for the usage
# limits (free plan at https://upstash.com, or through Vercel's Storage tab).
# Vercel's Upstash integration may add them as KV_REST_API_URL and
# KV_REST_API_TOKEN instead; both names work. Used on the server only.
# Without them, corrections still work but aren't counted or limited.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: corrections allowed for the whole site, per minute and per day.
# The day starts at 00:00 UTC. Defaults: 10 and 100.
# LIMIT_PER_MINUTE=10
# LIMIT_PER_DAY=100
